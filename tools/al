#!/bin/bash
# al —— Agent Lightroom 的命令行入口（在 Lightroom 外面包的一层 CLI）。
#
# 用法：
#   al import <文件夹>   全自动把该文件夹导入 Lightroom（打开窗口 + 自动点「导入」）
#   al source <文件夹>   只载入到工作台，不发起导入
#   al bridge            确保 LR 桥接插件轮询处于运行状态
#   al status            查看桥接/插件/catalog 状态
#
# 依赖：bridge（launchd: com.agentlightroom.bridge）、dsh-cua、Lightroom 已启动。
set -uo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
APP="${AGENT_LIGHTROOM_APP:-$HOME/Library/Developer/Xcode/DerivedData/AgentLightroom-glqzipctcucfubekiffurhnrambh/Build/Products/Debug/Agent Lightroom.app}"
HEALTH="http://127.0.0.1:8765/health"

ensure_bridge_service() {
    curl -s --max-time 2 "$HEALTH" >/dev/null 2>&1 && return 0
    echo "▸ 启动 bridge 服务"
    launchctl kickstart -k "gui/$(id -u)/com.agentlightroom.bridge" 2>/dev/null || true
    sleep 2
}

cmd="${1:-}"; shift || true
case "$cmd" in
  import|source)
    folder="${1:-}"
    [ -z "$folder" ] && { echo "用法: al $cmd <文件夹>"; exit 2; }
    [ -d "$folder" ] || { echo "✗ 不是文件夹: $folder"; exit 2; }
    ensure_bridge_service
    flag="--import"; [ "$cmd" = "source" ] && flag="--source"
    pkill -f "Agent Lightroom.app/Contents/MacOS" 2>/dev/null; sleep 2
    echo "▸ 启动工作台并$([ "$cmd" = import ] && echo 导入 || echo 载入): $folder"
    "$APP/Contents/MacOS/Agent Lightroom" $flag "$folder" >/tmp/al-run.log 2>&1 &
    sleep 3
    echo "▸ 完成（日志 /tmp/al-run.log）。状态可查: al status"
    ;;
  bridge)
    "$DIR/start-lr-bridge.sh"
    ;;
  status)
    curl -s --max-time 3 "$HEALTH" | python3 -c "
import sys,json
d=json.load(sys.stdin)
lr=d.get('lastResult') or {}
print('bridge  queue =',d.get('queue'))
print('插件    最近回报 =',lr.get('status'),'/',lr.get('message'))
print('catalog 回灌条数 =',len(d.get('culling',[])))
" 2>/dev/null || echo "bridge 不可达"
    ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
