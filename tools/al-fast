def positional_trustworthy(fields):
    """位置式解析的可信度检查。返回 (可信?, 越界字段列表)。"""
    bad = []
    for k, allowed in ENUM_KEYS.items():
        v = fields.get(k)
        if v is None:
            continue
        if not any(a in v for a in allowed):
            bad.append(f"{k}={v!r}")
    return (not bad), bad


