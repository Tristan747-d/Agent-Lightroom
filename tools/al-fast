def _sub_value(subs, parent, name):
    """从子字段表里取 (子字段名, 值) 列表中的某项（行式解析会把「问题/依据/理由」
    这类无主字段名挂到上一个主字段下）。取不到返回空串。"""
    for k, v in (subs or {}).get(parent, []) or []:
        if k == name:
            return v
    return ""


def parse_positional(text, order):
    """位置式解析：把第 i 行赋给 order[i]。行数不足即视为截断，由调用方重跑。"""
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    cleaned = []
    for l in lines:
        l = re.sub(r'^\s*\d+\s*[.、)]\s*', '', l)
        l = re.sub(r'^\s*[-*]\s*', '', l)
        if ':' in l or '：' in l:
            head, _, tail = l.replace('：', ':').partition(':')
            if head.strip() in order:
                l = tail.strip()
        cleaned.append(l)
    fields = {}
    for k, v in zip(order, cleaned):
        fields[k] = v
    return fields, cleaned


def vlm_ask(image, prompt, max_tokens, timeout=1800):
    body = json.dumps({"image": image, "prompt": prompt, "max_tokens": max_tokens}).encode()
    req = urllib.request.Request(VLM, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())["text"]


# ───────────────────────────── 常驻数值测量 ─────────────────────────────
class Measure:
    """常驻 al-vision 测量客户端：把「起进程 + Swift 启动 + Vision 框架冷启动」这三块
    固定开销压掉。实现方式是把 al-vision 的输出按文件名缓存到内存 + 走一次批量调用。"""

    def __init__(self, use_cache=True):
        self.cache = {}
        self.use_cache = use_cache

    def one(self, path):
        if self.use_cache and path in self.cache:
            return self.cache[path]
        try:
            r = subprocess.run([AL_VISION, path], capture_output=True, text=True, timeout=180)
            if r.returncode != 0 or not r.stdout.strip():
                return None
            d = json.loads(r.stdout)
        except Exception:
            return None
        if self.use_cache:
            self.cache[path] = d
        return d

    def batch(self, paths, workers=2):
        """并行测多张（每张仍是独立进程，但不再串行等待）。"""
        with ThreadPoolExecutor(max_workers=workers) as ex:
            return list(ex.map(self.one, paths))


