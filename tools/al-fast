def rule_layer(name):
    try:
        p = subprocess.run([os.path.join(HERE, "al-analyze"), name, "--json"],
                           capture_output=True, text=True, timeout=180)
        if p.returncode != 0 or not p.stdout.strip():
            return None
        return json.loads(p.stdout).get("decision")
    except Exception:
        return None


def build_params(dec, before, digest):
    """工序②：规则数值 + VLM 语义 → 最终参数（与 al-test3 逐条一致）。"""
    params, notes = {}, []
    develop = (dec or {}).get("develop") or {}
    crop = (dec or {}).get("crop") or {}
    fields = before or {}
    tone = (digest or {}).get("tone", {})
    mean_luma = tone.get("mean_luma", 120)

    for k, v in develop.items():
        if k in PLAIN_MAP:
            params[PLAIN_MAP[k]] = v
        elif k == "TemperatureDelta":
            params["temperature"] = round(max(-100.0, min(100.0, float(v) / KELVIN_TO_LR)))
        elif k in ("Tint", "TintDelta"):
            params["tint"] = round(float(v))

    skin = fields.get("肤色", "")
    ppl = fields.get("人物情况", "")
    wb = fields.get("白平衡情况", "")
    has_people = bool(ppl) and "无人物" not in ppl
    if has_people and skin == "自然":
        for key in ("temperature", "tint"):
            if key in params and abs(params[key]) > 5:
                notes.append(f"白平衡收窄 {key} {params[key]}→{5 if params[key]>0 else -5}（① 判定肤色自然，勿改现场光）")
                params[key] = 5 if params[key] > 0 else -5
    if wb == "准确":
        for key in ("temperature", "tint"):
            if key in params:
                notes.append(f"白平衡归零 {key}（① 判定白平衡准确）")
                params.pop(key, None)

    color = fields.get("色彩情况", "")
    if color == "过艳" and params.get("vibrance", 0) > 0:
        notes.append(f"vibrance {params['vibrance']}→-5（① 判过艳，不该加饱和）")
        params["vibrance"] = -5

    dehaze_need = fields.get("需要去朦胧", "")
    if "否" in dehaze_need:
        if params.pop("dehaze", None) is not None:
            notes.append("撤销 dehaze（① 判定不需要去朦胧）")
    elif "是" in dehaze_need:
        params.setdefault("dehaze", 15)
        notes.append("启用 dehaze +15（① 判定需要去朦胧）")

    clip_hi = tone.get("clip_high_pct", tone.get("clipped_high_pct", 0))
    if clip_hi > 1.0 and params.get("highlights", 0) > -10:
        params["highlights"] = -45
        notes.append(f"高光溢出 {clip_hi:.2f}% → highlights=-45")

    subject_dark = "主体比背景暗" in fields.get("主体明暗", "")
    clip_lo = tone.get("clip_low_pct", tone.get("clipped_low_pct", 0))
    if (subject_dark or clip_lo > 2.0) and params.get("shadows", 0) < 15:
        params["shadows"] = 30
        notes.append(f"提阴影 +30（{'主体比背景暗' if subject_dark else f'死黑 {clip_lo:.2f}%'}）")

    ang = params.pop("straighten", None)
    if ang is not None:
        notes.append(f"丢弃手动 StraightenAngle {ang}（改用 optics 自动透视）")
    crop.pop("StraightenAngle", None)

    labels = " ".join(str(l.get("id", "")) for l in (digest or {}).get("labels", [])).lower()
    if ("night" in labels or "sky" in labels) or mean_luma < 25:
        if params.get("shadows", 0) > 15:
            params["shadows"] = 15
            notes.append("夜景限幅 shadows→15")
        params.pop("blacks", None)
    return params, notes


def read_develop_many(names):
    """一次 sqlite 查询回读多张的 develop 设置（合并掉每张一次的 sqlite3 子进程）。"""
    if not names:
        return {}
    out = {}
    con = sqlite3.connect(f"file:{CATALOG}?mode=ro", uri=True, timeout=15)
    try:
        q = ("select f.idx_filename, d.text from Adobe_imageDevelopSettings d "
             "join Adobe_images i on i.id_local=d.image "
             "join AgLibraryFile f on f.id_local=i.rootFile "
             "where f.idx_filename in (%s)" % ",".join("?" * len(names)))
        for fn, text in con.execute(q, names):
            vals = {}
            for line in (text or "").splitlines():
                if "=" not in line:
                    continue
                k, _, v = line.partition("=")
                v = v.strip().rstrip(",}").strip()
                try:
                    vals[k.strip()] = float(v)
                except ValueError:
                    continue
            out[fn] = vals
    finally:
        con.close()
    return out


def send(cmd_obj, attempts=8, need="/"):
    for _ in range(attempts):
        try:
            p = subprocess.run([AL_CMD, json.dumps(cmd_obj), "--expect", "ok,error",
                                "--timeout", "10", "--attempts", "1", "--quiet"],
                               capture_output=True, text=True, timeout=60)
            line = (p.stdout or "").strip().splitlines()
            if not line:
                continue
            o = json.loads(line[-1])
            if o.get("status") != "ok":
                return False, o.get("message", "error")
            if need in o.get("message", ""):
                return True, o["message"]
        except Exception:
            pass
    return False, "no verified reply"


def read_pick(name):
    try:
        con = sqlite3.connect(f"file:{CATALOG}?mode=ro", uri=True, timeout=15)
        row = con.execute("select i.pick from Adobe_images i "
                          "join AgLibraryFile f on f.id_local=i.rootFile "
                          "where f.idx_filename=?", (name,)).fetchone()
        con.close()
        return row[0] if row else None
    except Exception:
        return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--names", default="")
    ap.add_argument("--progress", default=PROGRESS)
    ap.add_argument("--max-tokens", type=int, default=400)
    ap.add_argument("--pos", action="store_true", help="用位置式（只输出值）提示，省输出令牌")
    ap.add_argument("--lean", action="store_true",
                    help="⚠️ 精简提示（省~36%%令牌但实测降低语义质量：主题/表情会判错、"
                         "可能幻觉出 dehaze）。仅供对照实验，生产禁用")
    ap.add_argument("--no-parallel-render", action="store_true",
                    help="消融：关掉「渲染与 VLM① 并行」")
    ap.add_argument("--dry", action="store_true", help="只跑到出参数，不写 Lightroom")
    ap.add_argument("--report", default="/tmp/al-fast-report.json")
    args = ap.parse_args()

    if args.names:
        names = [n.strip() for n in args.names.split(",") if n.strip()]
    else:
        names = sorted(f for f in os.listdir(PHOTO_DIR)
                       if f.lower().endswith((".jpg", ".jpeg", ".png", ".heic")))

    done = set()
    if os.path.exists(args.progress):
        for line in open(args.progress):
            try:
                r = json.loads(line)
                if r.get("status") in ("edited", "skipped"):
                    done.add(r["name"])
            except Exception:
                pass
    todo = [n for n in names if n not in done]
    if args.limit:
        todo = todo[:args.limit]
    print(f"待处理 {len(todo)} / 共 {len(names)}（已完成 {len(done)}）", flush=True)
    if args.lean:
        print("⚠️  --lean 已启用：实测会降低语义质量（主题/表情误判、可能幻觉 dehaze），"
              "仅供对照实验；生产请去掉该参数。", flush=True)
    if args.pos:
        print("ℹ️  --pos（位置式）在 4B 模型上不可靠，会回退行式；仅用于验证校验逻辑。",
              flush=True)

    meas = Measure()
    stats = {"edited": 0, "skipped": 0, "failed": 0, "culled": 0}
    per_stage = {"①measure": 0.0, "①vlm": 0.0, "②write": 0.0, "③render": 0.0,
                 "③vlm": 0.0, "④fix": 0.0, "readback": 0.0}
    t_all = time.time()
    rows = []

    with open(args.progress, "a") as fh:
        for i, name in enumerate(todo, 1):
            t0 = time.time()
            rec = {"name": name, "ts": int(time.time()), "stages": {}}
            path = os.path.join(PHOTO_DIR, name)

            # ── 工序①：原片数值测量（与 VLM 读图互不依赖，可并行）──
            need_render = not args.no_parallel_render
            pool = ThreadPoolExecutor(max_workers=2) if need_render else None
            # 真并行：测量与渲染**提交后不等待**，让它们与下面耗时的 VLM① 重叠。
            # （曾写成 submit 后立刻 result()，等于串行——那是指标好看但没提速的假优化。）
            t = time.time()
            fut_measure = pool.submit(meas.one, path) if pool else None
            fut_render = (pool.submit(subprocess.run, [AL_SEE, name],
                                      capture_output=True, text=True, timeout=180)
                          if pool else None)
            digest = fut_measure.result() if fut_measure else meas.one(path)
            per_stage["①measure"] += time.time() - t
            if digest is None:
                rec["status"] = "failed"; rec["why"] = "原片测量失败"
                stats["failed"] += 1
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n"); fh.flush()
                print(f"[{i}/{len(todo)}] {name}: FAILED 原片不可读", flush=True)
                if pool: pool.shutdown()
                continue

            # ── 工序① VLM（原片！不是预览缓存）── 与测量/渲染并行
            t_v = time.time()
            if args.pos:
                raw = vlm_ask(path, PROMPT_BEFORE_POS, args.max_tokens)
                f1, lines = parse_positional(raw, POS_ORDER_BEFORE)
                f1_subs = {}
                missing1 = [k for k in BEFORE_KEYS if k not in f1]
                okp, badp = positional_trustworthy(f1)
                if missing1 or not okp:           # 截断或串位 → 回退行式，绝不用可疑值
                    rec.setdefault("warnings", []).append(
                        f"位置式不可信(missing={missing1} 越界={badp}) → 回退行式")
                    raw = vlm_ask(path, PROMPT_BEFORE_LEAN if args.lean else PROMPT_BEFORE,
                                  args.max_tokens)
                    f1, f1_subs, lines = parse_lossless(raw, BEFORE_KEYS)
                    missing1 = [k for k in BEFORE_KEYS if k not in f1]
            else:
                raw = vlm_ask(path, PROMPT_BEFORE_LEAN if args.lean else PROMPT_BEFORE,
                              args.max_tokens)
                f1, f1_subs, lines = parse_lossless(raw, BEFORE_KEYS)
                missing1 = [k for k in BEFORE_KEYS if k not in f1]
            per_stage["①vlm"] += time.time() - t_v
            rec["stages"]["①"] = {"fields": f1, "lines": len(lines),
                                  "missing": missing1, "raw_chars": len(raw),
                                  "measure": {k: digest.get(k) for k in
                                              ("tone", "color", "sharpness", "horizon", "faces")}}

            dec = rule_layer(name)
            if dec is None:
                rec["status"] = "failed"; rec["why"] = "规则层失败"
                stats["failed"] += 1
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n"); fh.flush()
                if pool: pool.shutdown()
                continue
            if dec.get("skip_tuning"):
                rec["status"] = "skipped"; rec["why"] = "非摄影图片"
                stats["skipped"] += 1
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n"); fh.flush()
                print(f"[{i}/{len(todo)}] {name}: skipped (非摄影)", flush=True)
                if pool: pool.shutdown()
                continue

            # ── 工序②：写 Lightroom ──
            params, notes = build_params(dec, f1, digest)
            rec["stages"]["②"] = {"params": params, "notes": notes}

            t = time.time()
            ok_opt, msg_opt = send({"type": "optics", "name": name})
            if params and not args.dry:
                send({"type": "develop", "name": name, **params})
            per_stage["②write"] += time.time() - t

            t = time.time()
            after = read_develop_many([name]).get(name, {})
            per_stage["readback"] += time.time() - t
            optics_ok = all(abs(after.get(k, 0) - 1) < 0.01
                            for k in ("LensProfileEnable", "AutoLateralCA", "PerspectiveUpright"))
            hit = 0
            for pk, pv in params.items():
                got = after.get(LR_KEY.get(pk, pk))
                if got is not None and abs(got - float(pv)) < 1.01:
                    hit += 1
            rec["stages"]["②"]["readback"] = f"{hit}/{len(params)}"
            rec["stages"]["②"]["optics"] = optics_ok

            # 等渲染完成（若并行）
            t = time.time()
            if fut_render:
                try:
                    fut_render.result()
                except Exception:
                    pass
            per_stage["③render"] += time.time() - t

            # ── 工序③：VLM 复查（渲染结果）──
            t_v = time.time()
            if args.pos:
                raw = vlm_ask(VIEW, PROMPT_AFTER_POS, args.max_tokens)
                f3, lines3 = parse_positional(raw, POS_ORDER_AFTER)
                missing3 = [k for k in AFTER_KEYS if k not in f3]
                okp3, badp3 = positional_trustworthy(f3)
                if missing3 or not okp3:
                    rec.setdefault("warnings", []).append(
                        f"③位置式不可信(missing={missing3} 越界={badp3}) → 回退行式")
                    raw = vlm_ask(VIEW, PROMPT_AFTER_LEAN if args.lean else PROMPT_AFTER,
                                  args.max_tokens)
                    f3, _, lines3 = parse_lossless(raw, AFTER_KEYS)
                    missing3 = [k for k in AFTER_KEYS if k not in f3]
            else:
                raw = vlm_ask(VIEW, PROMPT_AFTER_LEAN if args.lean else PROMPT_AFTER,
                              args.max_tokens)
                f3, _, lines3 = parse_lossless(raw, AFTER_KEYS)
                missing3 = [k for k in AFTER_KEYS if k not in f3]
            per_stage["③vlm"] += time.time() - t_v
            rec["stages"]["③"] = {"fields": f3, "lines": len(lines3), "missing": missing3}

            # ── 构图 → 裁切补救 ──
            # ⚠️ 继承自 al-test3 的 bug：行式解析里「问题/构图问题」是**子字段**
            # （BEFORE_KEYS 没有它 → parse_lossless 归到 subs），
            # 直接 fields.get("问题") 恒为 None，导致「背景干扰/主体太靠边」这条
            # 裁切判据在旧代码里是**死代码**。这里同时查主字段与子字段。
            comp = f1.get("构图", "")
            cprob = f1.get("构图问题", "") or _sub_value(f1_subs, "构图", "问题") \
                    or _sub_value(f1_subs, "构图", "构图问题")
            need_crop = any(t in comp for t in ("主体过小", "主体被裁切", "杂乱")) \
                        or any(t in cprob for t in ("主体太靠边", "背景干扰"))
            if need_crop and not args.dry:
                crop = {"CropTop": 0.08, "CropBottom": 0.92,
                        "CropLeft": 0.10, "CropRight": 0.90, "CropAngle": 0.0}
                ok_c, msg_c = send({"type": "develop_set", "name": name, "settings": crop})
                rec["stages"]["②"]["crop"] = {"why": comp or cprob, "ok": ok_c, "msg": msg_c}

            # ── 废片排除：数值 + VLM 双判据必须一致 ──
            cull = None
            sharp = (digest.get("sharpness") or {}).get("laplacian_var", 1e9)
            faces = digest.get("faces") or {}
            face_items = faces.get("items") or []
            min_face_sharp = min((f.get("face_sharpness", 1e9) for f in face_items), default=1e9)
            eyes_shut = any(not f.get("eyes_open", True) for f in face_items)
            blurry_num = sharp < 30 or min_face_sharp < 25
            expr_vlm = f1.get("表情", "")
            focus_vlm = f1.get("焦点情况", "")
            if blurry_num and ("虚焦" in focus_vlm or "模糊" in focus_vlm):
                cull = f"虚焦(sharp={sharp:.0f} face={min_face_sharp:.0f} vlm={focus_vlm})"
            elif eyes_shut and any(t in expr_vlm for t in ("闭眼", "眨眼", "尴尬")):
                cull = f"表情({expr_vlm} eyes_open=false)"
            if cull and not args.dry:
                ok_r, msg_r = send({"type": "reject", "files": [name]})
                rec["stages"]["cull"] = {"why": cull, "ok": ok_r,
                                         "pick_readback": read_pick(name), "msg": msg_r}
                stats["culled"] += 1

            # ── 工序④：仅当 ③ 不达标，单参数、幅度有界、逐个回读自证 ──
            fixes, applied = [], []
            if f3:
                if f3.get("高光") and f3["高光"] != "保住":
                    fixes.append(("highlights", -15))
                if f3.get("阴影") == "死黑":
                    fixes.append(("shadows", +10))
                if "偏黄" in f3.get("白平衡情况", ""):
                    fixes.append(("tint", -3))
                if "偏蓝" in f3.get("白平衡情况", ""):
                    fixes.append(("temperature", +5))
                if f3.get("色彩情况") == "过艳":
                    fixes.append(("vibrance", -5))
            t = time.time()
            if fixes:
                for k, d in fixes[:2]:
                    base = params.get(k, 0)
                    nv = max(-100, min(100, base + d))
                    if args.dry:
                        applied.append([k, nv, "dry"]); continue
                    ok_fix, msg_fix = send({"type": "develop", "name": name, k: nv})
                    cur = read_develop_many([name]).get(name, {})
                    got_v = cur.get(LR_KEY.get(k, k))
                    if got_v is not None and abs(got_v - nv) < 1.01:
                        params[k] = nv
                        applied.append([k, nv, "verified"])
                    else:
                        rec.setdefault("warnings", []).append(
                            f"④ {k}→{nv} 未落库(实际{got_v}) msg={msg_fix}")
            per_stage["④fix"] += time.time() - t
            rec["stages"]["④"] = {"fixes": fixes, "applied": applied}

            rec["status"] = "edited"
            rec["params"] = params
            rec["elapsed_sec"] = round(time.time() - t0, 1)
            stats["edited"] += 1
            rows.append(rec)

            fh.write(json.dumps(rec, ensure_ascii=False) + "\n"); fh.flush()
            print(f"[{i}/{len(todo)}] {name}: edited "
                  f"①{len(f1)}f/③{len(f3)}f miss={len(missing1)},{len(missing3)} "
                  f"optics={optics_ok} rb={hit}/{len(params)} "
                  f"{'④'+str(len(fixes)) if fixes else ''} ({rec['elapsed_sec']:.0f}s)", flush=True)
            if pool:
                pool.shutdown()

    stats["elapsed_sec"] = round(time.time() - t_all, 1)
    stats["per_stage_sec"] = {k: round(v, 1) for k, v in per_stage.items()}
    stats["per_image_sec"] = round(stats["elapsed_sec"] / max(1, stats["edited"] + stats["skipped"]), 1)
    print("\n=== 汇总 ===", json.dumps(stats, ensure_ascii=False))
    try:
        with open(args.report, "w") as f:
            json.dump({"stats": stats, "rows": rows}, f, ensure_ascii=False, indent=1)
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
