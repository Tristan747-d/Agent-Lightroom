def build_pos_prompt(spec, title):
    lines = [f"看这张{title}的照片。严格按下面顺序，每行**只写值**，"
             f"不要字段名、不要序号、不要解释。",
             f"必须输出全部 {len(spec)} 行，一行不许少。尖括号是取值要求，不是要你写的字。", ""]
    for i, (_, hint) in enumerate(spec, 1):
        lines.append(f"{i} {hint}")
    return "\n".join(lines) + "\n"


