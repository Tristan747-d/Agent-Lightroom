def parse_lossless(text, keys):
    """无损解析（与 al-vlm-check2 同实现）：主字段进 dict，子字段挂父字段，另存原始行。"""
    ordered, subs, lines = {}, {}, []
    last = None
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        lines.append(line)
        if ":" not in line and "：" not in line:
            continue
        k, _, v = line.replace("：", ":").partition(":")
        k, v = k.strip(), v.strip()
        if not k:
            continue
        if k in keys:
            ordered[k] = v
            subs.setdefault(k, [])
            last = k
        elif last:
            subs[last].append((k, v))
    return ordered, subs, lines


