#!/usr/bin/env python3
"""al-test3 —— 严格按 routine-editpii-gen-1 skill 的四道工序逐张修图（test3）。

工序：
  ① VLM 看前期状态 —— 测**原片**（不是预览缓存）+ VLM 22 字段读图 + 我自己看图
  ② 套用配方      —— optics 光学矫正 + 影调参数（由规则层给数，VLM 语义约束）
  ③ VLM 复查      —— 渲染修完的样子 + VLM --after 对照 ①
  ④ 微调          —— 仅当 ③ 不达标，单参数、幅度 ≤15

关键铁律（全部来自实测事故）：
  * 测量用**原片**（al-vision 读原图绝对路径），绝不用 al-see 预览缓存当基准
    —— 缓存已含当前 develop，会造成反馈回路。
  * 工序①③ 必须真调 VLM（Qwen3-VL-4B @8321），不是可选。
  * 语义/测量分工：数值（几何/溢出/锐度/白平衡比值）信 al-vision；
    语义（主题/主体/人物/肤色/噪点/去朦胧）信 VLM；分歧以测量为准。
  * 每步输出**全部字段**，不许省略；完整度不足即记录并重试。

用法:
    python3 tools/al-test3 --limit 5          # 小样
    python3 tools/al-test3 --names "a.jpg"
    python3 tools/al-test3                    # 全量（断点续跑）
"""
import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
PHOTO_DIR = os.path.expanduser("~/Pictures/Agent Lightroom Test")
CATALOG = os.path.expanduser("~/Pictures/Lightroom/AgentTest/AgentTest.lrcat")
PROGRESS = "/tmp/al-test3-progress.jsonl"
VLM = "http://127.0.0.1:8321/describe"
AL_CMD = os.path.join(HERE, "al-cmd")
AL_VISION = os.path.join(HERE, "al-vision")

KELVIN_TO_LR = 4.0
PLAIN_MAP = {
    "Exposure2012": "exposure", "Contrast2012": "contrast",
    "Highlights2012": "highlights", "Shadows2012": "shadows",
    "Whites2012": "whites", "Blacks2012": "blacks",
    "Vibrance": "vibrance", "Saturation": "saturation",
    "Clarity2012": "clarity", "Texture": "texture", "Dehaze": "dehaze",
}


# ───────────────────────── 工序① 测量（原片！） ─────────────────────────
def measure_original(name):
    """测**原片**的数值（几何/溢出/锐度/白平衡比值）。绝不读预览缓存。"""
    p = os.path.join(PHOTO_DIR, name)
    if not os.path.isfile(p):
        return None
    try:
        r = subprocess.run([AL_VISION, p], capture_output=True, text=True, timeout=180)
        if r.returncode != 0 or not r.stdout.strip():
            return None
        return json.loads(r.stdout)
    except Exception:
        return None


def vlm_read(image_path, after=False, timeout=900):
    """工序①/③：VLM 结构化读图。返回 (字段dict, 原始行list, 完整度)。"""
    tool = os.path.join(HERE, "al-vlm-check2")
    cmd = [tool, image_path, "--json"]
    if after:
        cmd.append("--after")
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if r.returncode != 0 or not r.stdout.strip():
            return None, [], "tool-failed"
        d = json.loads(r.stdout)
        if "error" in d:
            return None, [], d["error"]
        return d.get("fields", {}), d.get("_lines", []), "ok"
    except Exception as e:
        return None, [], str(e)


# ───────────────────────── 规则层（出数值） ─────────────────────────
def rule_layer(name):
    """跑现有规则链拿数值草稿（它内部用预览缓存，故仅作数值参考，
    真正的场景判断由 VLM 语义 + 原片测量负责）。"""
    try:
        p = subprocess.run([os.path.join(HERE, "al-analyze"), name, "--json"],
                           capture_output=True, text=True, timeout=180)
        if p.returncode != 0 or not p.stdout.strip():
            return None
        return json.loads(p.stdout).get("decision")
    except Exception:
        return None


# ───────────────────────── 工序② 套配方 ─────────────────────────
def build_params(dec, before, digest):
    """结合规则数值 + VLM 语义，产出最终参数。返回 (params, notes)。"""
    params, notes = {}, []
    develop = (dec or {}).get("develop") or {}
    crop = (dec or {}).get("crop") or {}
    fields = before or {}

    tone = (digest or {}).get("tone", {})
    mean_luma = tone.get("mean_luma", 120)

    for k, v in develop.items():
        if k in PLAIN_MAP:
            params[PLAIN_MAP[k]] = v
        elif k == "TemperatureDelta":
            lr = max(-100.0, min(100.0, float(v) / KELVIN_TO_LR))
            params["temperature"] = round(lr)
        elif k in ("Tint", "TintDelta"):
            params["tint"] = round(float(v))

    # ── 白平衡复核（skill 2.3）：肤色自然 / 有人物 → 收窄幅度 ──
    skin = fields.get("肤色", "")
    ppl = fields.get("人物情况", "")
    wb = fields.get("白平衡情况", "")
    has_people = bool(ppl) and "无人物" not in ppl
    if has_people and skin == "自然":
        for key in ("temperature", "tint"):
            if key in params and abs(params[key]) > 5:
                notes.append(f"白平衡收窄 {key} {params[key]}→{5 if params[key]>0 else -5}（① 判定肤色自然，勿改现场光）")
                params[key] = 5 if params[key] > 0 else -5
    if wb == "准确":
        for key in ("temperature", "tint"):
            if key in params:
                notes.append(f"白平衡归零 {key}（① 判定白平衡准确）")
                params.pop(key, None)

    # ── 色彩：过艳则降 vibrance（skill ④）──
    color = fields.get("色彩情况", "")
    if color == "过艳" and params.get("vibrance", 0) > 0:
        notes.append(f"vibrance {params['vibrance']}→-5（① 判过艳，不该加饱和）")
        params["vibrance"] = -5

    # ── 去朦胧：仅当 ① 明确说需要（skill 2.2）──
    dehaze_need = fields.get("需要去朦胧", "")
    if "否" in dehaze_need:
        if params.pop("dehaze", None) is not None:
            notes.append("撤销 dehaze（① 判定不需要去朦胧）")
    elif "是" in dehaze_need:
        params.setdefault("dehaze", 15)
        notes.append("启用 dehaze +15（① 判定需要去朦胧）")

    # ── 高光：溢出 > 1% 就压（陷阱 1：不能因测不出就跳过）──
    clip_hi = tone.get("clip_high_pct", 0)
    if clip_hi > 1.0 and params.get("highlights", 0) > -10:
        params["highlights"] = -45
        notes.append(f"高光溢出 {clip_hi:.2f}% → highlights=-45")

    # ── 阴影：主体在暗部 或 死黑 > 2%（skill 2.4）──
    subject_dark = "主体比背景暗" in fields.get("主体明暗", "")
    clip_lo = tone.get("clip_low_pct", 0)
    if (subject_dark or clip_lo > 2.0) and params.get("shadows", 0) < 15:
        params["shadows"] = 30
        notes.append(f"提阴影 +30（{'主体比背景暗' if subject_dark else f'死黑 {clip_lo:.2f}%'}）")

    # ── 几何：一律用原片实测角度（不信 VLM 的"是/否"）──
    ang = params.pop("straighten", None)          # 丢掉规则层的手动旋转
    if ang is not None:
        notes.append(f"丢弃手动 StraightenAngle {ang}（改用 optics 自动透视）")
    crop.pop("StraightenAngle", None)

    # ── 夜景守则 ──
    labels = " ".join(str(l.get("id", "")) for l in (digest or {}).get("labels", [])).lower()
    if ("night" in labels or "sky" in labels) or mean_luma < 25:
        if params.get("shadows", 0) > 15:
            params["shadows"] = 15
            notes.append("夜景限幅 shadows→15")
        params.pop("blacks", None)

    return params, notes


# ───────────────────────── 写回 + 回读 ─────────────────────────
def read_develop(name):
    con = sqlite3.connect(f"file:{CATALOG}?mode=ro", uri=True, timeout=15)
    try:
        r = con.execute(
            "select d.text from Adobe_imageDevelopSettings d "
            "join Adobe_images i on i.id_local=d.image "
            "join AgLibraryFile f on f.id_local=i.rootFile "
            "where f.idx_filename=?", (name,)).fetchone()
    finally:
        con.close()
    if not r or not r[0]:
        return {}
    out = {}
    for line in r[0].splitlines():
        if "=" not in line:
            continue
        k, _, v = line.partition("=")
        v = v.strip().rstrip(",}").strip()
        try:
            out[k.strip()] = float(v)
        except ValueError:
            continue
    return out


def send(cmd_obj, attempts=8, need="/"):
    for _ in range(attempts):
        try:
            p = subprocess.run([AL_CMD, json.dumps(cmd_obj), "--expect", "ok,error",
                                "--timeout", "10", "--attempts", "1", "--quiet"],
                               capture_output=True, text=True, timeout=60)
            line = (p.stdout or "").strip().splitlines()
            if not line:
                continue
            o = json.loads(line[-1])
            if o.get("status") != "ok":
                return False, o.get("message", "error")
            if need in o.get("message", ""):
                return True, o["message"]
        except Exception:
            pass
    return False, "no verified reply"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--names", default="")
    ap.add_argument("--no-mic", action="store_true", help="跳过我自己看图")
    args = ap.parse_args()

    if args.names:
        names = [n.strip() for n in args.names.split(",") if n.strip()]
    else:
        names = sorted(f for f in os.listdir(PHOTO_DIR)
                       if f.lower().endswith((".jpg", ".jpeg", ".png", ".heic")))

    done = set()
    if os.path.exists(PROGRESS):
        for line in open(PROGRESS):
            try:
                r = json.loads(line)
                if r.get("status") in ("edited", "skipped"):
                    done.add(r["name"])
            except Exception:
                pass
    todo = [n for n in names if n not in done]
    if args.limit:
        todo = todo[:args.limit]
    print(f"待处理 {len(todo)} / 共 {len(names)}（已完成 {len(done)}）", flush=True)

    stats = {"edited": 0, "skipped": 0, "failed": 0, "noop": 0}
    t0 = time.time()
    with open(PROGRESS, "a") as fh:
        for i, name in enumerate(todo, 1):
            rec = {"name": name, "ts": int(time.time()), "stages": {}}

            # ── 工序① ──
            digest = measure_original(name)
            if digest is None:
                rec["status"] = "failed"; rec["why"] = "原片测量失败"
                stats["failed"] += 1
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n"); fh.flush()
                print(f"[{i}/{len(todo)}] {name}: FAILED 原片不可读", flush=True)
                continue
            fields, lines, vstatus = vlm_read(os.path.join(PHOTO_DIR, name), after=False)
            rec["stages"]["①"] = {"fields": fields, "lines": len(lines), "vlm": vstatus,
                                  "measure": {k: digest.get(k) for k in ("tone", "color", "sharpness", "horizon")}}

            dec = rule_layer(name)
            if dec is None:
                rec["status"] = "failed"; rec["why"] = "规则层失败"
                stats["failed"] += 1
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n"); fh.flush()
                continue

            if dec.get("skip_tuning"):
                rec["status"] = "skipped"; rec["why"] = "非摄影图片"
                stats["skipped"] += 1
                fh.write(json.dumps(rec, ensure_ascii=False) + "\n"); fh.flush()
                print(f"[{i}/{len(todo)}] {name}: skipped (非摄影)", flush=True)
                continue

            # ── 工序② ──
            params, notes = build_params(dec, fields, digest)
            rec["stages"]["②"] = {"params": params, "notes": notes}

            ok_opt, msg_opt = send({"type": "optics", "name": name})
            time.sleep(0.25)
            if params:
                send({"type": "develop", "name": name, **params})
                time.sleep(0.35)

            after = read_develop(name)
            optics_ok = all(abs(after.get(k, 0) - 1) < 0.01
                            for k in ("LensProfileEnable", "AutoLateralCA", "PerspectiveUpright"))
            want = {k: v for k, v in params.items()}
            hit = 0
            for pk, pv in want.items():
                lrk = {"exposure": "Exposure2012", "contrast": "Contrast2012",
                       "highlights": "Highlights2012", "shadows": "Shadows2012",
                       "whites": "Whites2012", "blacks": "Blacks2012", "vibrance": "Vibrance",
                       "clarity": "Clarity2012", "texture": "Texture", "dehaze": "Dehaze",
                       "temperature": "IncrementalTemperature", "tint": "IncrementalTint"}.get(pk, pk)
                got = after.get(lrk)
                if got is not None and abs(got - float(pv)) < 1.01:
                    hit += 1
            rec["stages"]["②"]["readback"] = f"{hit}/{len(want)}"
            rec["stages"]["②"]["optics"] = optics_ok

            # ── 工序③（第二次 VLM，字段集与 ① 不同）──
            subprocess.run([os.path.join(HERE, "al-see"), name],
                           capture_output=True, text=True, timeout=120)
            af_fields, af_lines, af_status = vlm_read("/tmp/agent-lightroom-view.jpg", after=True)
            rec["stages"]["③"] = {"fields": af_fields, "lines": len(af_lines), "vlm": af_status}

            # ── gen-2 新增：构图 → 裁切补救（skill 工序④）──
            if fields:
                comp = fields.get("构图", "")
                cprob = fields.get("问题", "")
                need_crop = any(t in comp for t in ("主体过小", "主体被裁切", "杂乱")) \
                            or any(t in cprob for t in ("主体太靠边", "背景干扰"))
                if need_crop:
                    # 主体过小/靠边：收紧到中心 80%，并把主体推近三分线
                    crop = {"CropTop": 0.08, "CropBottom": 0.92,
                            "CropLeft": 0.10, "CropRight": 0.90, "CropAngle": 0.0}
                    ok_c, msg_c = send({"type": "develop_set", "name": name,
                                        "settings": crop})
                    time.sleep(0.35)
                    rec["stages"]["②"]["crop"] = {"why": comp or cprob,
                                                  "ok": ok_c, "msg": msg_c}

            # ── gen-2 新增：废片排除（虚焦 / 表情），双判据必须一致 ──
            cull = None
            if fields:
                sharp = (digest.get("sharpness") or {}).get("laplacian_var", 1e9)
                faces = digest.get("faces") or {}
                face_items = faces.get("items") or []
                min_face_sharp = min((f.get("face_sharpness", 1e9)
                                      for f in face_items), default=1e9)
                eyes_shut = any(not f.get("eyes_open", True) for f in face_items)
                blurry_num = sharp < 30 or min_face_sharp < 25
                expr_vlm = fields.get("表情", "")
                focus_vlm = fields.get("焦点情况", "")
                # 虚焦：数值 + VLM 双方一致
                if blurry_num and ("虚焦" in focus_vlm or "模糊" in focus_vlm):
                    cull = f"虚焦(sharp={sharp:.0f} face={min_face_sharp:.0f} vlm={focus_vlm})"
                # 表情废：数值(闭眼) + VLM 双方一致
                elif eyes_shut and any(t in expr_vlm for t in ("闭眼", "眨眼", "尴尬")):
                    cull = f"表情({expr_vlm} eyes_open=false)"
            if cull:
                ok_r, msg_r = send({"type": "reject", "files": [name]})
                time.sleep(0.3)
                cur_pick = None
                try:
                    conn = sqlite3.connect(f"file:{CATALOG}?mode=ro", uri=True)
                    row = conn.execute("select i.pick from Adobe_images i "
                                       "join AgLibraryFile f on f.id_local=i.rootFile "
                                       "where f.idx_filename=?", (name,)).fetchone()
                    conn.close()
                    cur_pick = row[0] if row else None
                except Exception:
                    pass
                rec["stages"]["cull"] = {"why": cull, "ok": ok_r,
                                         "pick_readback": cur_pick, "msg": msg_r}

            # ── 工序④（仅当 ③ 不达标）──
            fixes = []
            if af_fields:
                if af_fields.get("高光") and af_fields["高光"] != "保住":
                    fixes.append(("highlights", -15))
                if af_fields.get("阴影") == "死黑":
                    fixes.append(("shadows", +10))
                if "偏黄" in af_fields.get("白平衡情况", ""):
                    fixes.append(("tint", -3))
                if "偏蓝" in af_fields.get("白平衡情况", ""):
                    fixes.append(("temperature", +5))
                if af_fields.get("色彩情况") == "过艳":
                    fixes.append(("vibrance", -5))
            if fixes:
                applied = []
                for k, d in fixes[:2]:            # 一次最多动两个参数
                    base = params.get(k, 0)
                    nv = max(-100, min(100, base + d))
                    ok_fix, msg_fix = send({"type": "develop", "name": name, k: nv})
                    time.sleep(0.4)
                    # ④ 必须**回读确认**：曾经出现过 send 静默失败、
                    # 而 rec 里却记了 fixes（记录与实际不符）——这种"假成功"
                    # 比不修更糟。这里逐个回读，只有真落库才记 applied。
                    lrk = {"exposure": "Exposure2012", "contrast": "Contrast2012",
                           "highlights": "Highlights2012", "shadows": "Shadows2012",
                           "whites": "Whites2012", "blacks": "Blacks2012",
                           "vibrance": "Vibrance", "clarity": "Clarity2012",
                           "texture": "Texture", "dehaze": "Dehaze",
                           "temperature": "IncrementalTemperature",
                           "tint": "IncrementalTint"}.get(k, k)
                    cur = read_develop(name)
                    got_v = cur.get(lrk)
                    if got_v is not None and abs(got_v - nv) < 1.01:
                        params[k] = nv
                        applied.append([k, nv])
                    else:
                        rec.setdefault("warnings", []).append(
                            f"④ {k}→{nv} 未落库(实际{got_v}) msg={msg_fix}")
                rec["stages"]["④"] = {"fixes": fixes, "applied": applied,
                                      "params_after": params}

            rec["status"] = "edited"
            rec["params"] = params
            stats["edited"] += 1

            fh.write(json.dumps(rec, ensure_ascii=False) + "\n"); fh.flush()
            el = time.time() - t0
            print(f"[{i}/{len(todo)}] {name}: edited "
                  f"①{len(fields or {})}f/③{len(af_fields or {})}f "
                  f"optics={optics_ok} rb={hit}/{len(want)} "
                  f"{'④'+str(len(fixes)) if fixes else ''} ({el:.0f}s)", flush=True)

    stats["elapsed_sec"] = round(time.time() - t0, 1)
    print("\n=== 汇总 ===", json.dumps(stats, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
